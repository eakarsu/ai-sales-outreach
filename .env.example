NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://app_user@127.0.0.1:5432/ai_sales_outreach
PGSSLROOTCERT=
JWT_SECRET=
DEFAULT_TENANT_ID=tenant-local
CLIENT_URL=http://localhost:3000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
EMAIL_PROVIDER_ENABLED=false
ENABLE_GENERATED_FEATURES=false
ALLOW_SCHEMA_MIGRATION=0
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
